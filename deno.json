{
  "name": "@twitch-commander/plugin-sail",
  "version": "0.1.0",
  "license": "MIT",
  "exports": "./mod.ts",
  "exclude": ["sail.plugin.js", "lookups/"],
  "tasks": {
    "check": "deno check .",
    "test": "deno test",
    "fmt": "deno fmt",
    "lint": "deno lint",
    "bundle": "deno bundle mod.ts -o sail.plugin.js",
    "extract-lookups": "deno run -A scripts/extract_lookups.ts && deno fmt src/lookups.data.ts",
    "extract-catalog": "deno run -A scripts/extract_catalog.ts && deno fmt src/catalog.data.ts"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@twitch-commander/plugin": "../Commander/plugin-api/mod.ts"
  }
}
